# Copie para .env.local (dev) ou cadastre na Vercel (Settings > Environment Variables).
# Variaveis VITE_* sao embutidas no build: mudar exige um novo deploy.

# Base da API. Em dev, deixe em branco para usar o proxy /api do Vite (localhost:8080).
VITE_API_URL=

# Contas (e-mail) que veem a tela de Notificacoes, separadas por virgula.
# Em branco: todas as contas veem.
VITE_EMAIL_NOTIFICACOES=
